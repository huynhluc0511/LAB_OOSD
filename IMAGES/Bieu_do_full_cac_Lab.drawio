        <UserObject label="Sơ đồ Hoạt động - UC03: Quản lý Giỏ hàng" plantUmlId="title_0" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" plantUmlBaseValue="Sơ đồ Hoạt động - UC03: Quản lý Giỏ hàng" id="hNK0E6d8hQs80olfApI3-369">
          <mxCell parent="hNK0E6d8hQs80olfApI3-308" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1">
            <mxGeometry height="24" width="316" x="2596.25" y="13840" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide footbox\ntitle Sơ đồ Tuần tự - UC03: Quản lý Giỏ hàng\n\nactor \&quot;Khách hàng\&quot; as Customer\nparticipant \&quot;Giao diện Giỏ hàng\\n(Cart UI)\&quot; as UI\nparticipant \&quot;Bộ điều khiển Giỏ hàng\\n(Cart Controller)\&quot; as Controller\nparticipant \&quot;Dịch vụ Giỏ hàng\\n(Cart Service)\&quot; as CartService\ndatabase \&quot;CSDL\&quot; as DB\n\nCustomer -&gt; UI: 1. Mở màn hình Giỏ hàng\nUI -&gt; Controller: 2. getCartInfo(userID)\nController -&gt; CartService: 3. getCartItems(userID)\nCartService -&gt; DB: 4. Truy vấn giỏ hàng\nDB --&gt; CartService: 5. Trả về danh sách SP\nCartService --&gt; Controller: 6. Trả về chi tiết giỏ hàng\nController --&gt; UI: 7. Hiển thị danh sách SP &amp; Tổng tiền\n\nalt Cập nhật số lượng\n    Customer -&gt; UI: 8a. Thay đổi số lượng SP\n    UI -&gt; Controller: 9a. updateQuantity(productID, newQty)\n    Controller -&gt; CartService: 10a. validateAndUpdate(productID, newQty)\n    CartService -&gt; DB: 11a. Kiểm tra tồn kho &amp; Cập nhật CSDL\n    DB --&gt; CartService: 12a. Cập nhật thành công\n    CartService --&gt; Controller: 13a. Trả về tổng tiền mới\n    Controller --&gt; UI: 14a. Hiển thị giỏ hàng đã cập nhật\nelse Xóa sản phẩm\n    Customer -&gt; UI: 8b. Nhấn nút \&quot;Xóa SP\&quot;\n    UI -&gt; Controller: 9b. removeItem(productID)\n    Controller -&gt; CartService: 10b. deleteItem(productID)\n    CartService -&gt; DB: 11b. Xóa SP khỏi giỏ trong CSDL\n    DB --&gt; CartService: 12b. Xác nhận đã xóa\n    CartService --&gt; Controller: 13b. Trả về danh sách giỏ hàng mới\n    Controller --&gt; UI: 14b. Cập nhật giao diện giỏ hàng\nelse Tiến hành \&quot;Tính tiền\&quot;\n    Customer -&gt; UI: 8c. Nhấn \&quot;Tính tiền\&quot;\n    UI -&gt; Controller: 9c. proceedToCheckout()\n    Controller --&gt; UI: 10c. Chuyển hướng sang UC06 (Checkout)\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="hNK0E6d8hQs80olfApI3-416">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
