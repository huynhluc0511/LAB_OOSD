        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Sequence Diagram - UC10: Xem Dashboard và xuất báo cáo\nautonumber\nactor \&quot;Quản lý năng lượng\&quot; as Manager\nboundary \&quot;UI React Dashboard\&quot; as UI\ncontrol \&quot;Report Controller\&quot; as Ctrl\nentity \&quot;PostgreSQL\&quot; as DB\n\nManager -&gt; UI: Mở Dashboard / Chọn bộ lọc thời gian\nUI -&gt; Ctrl: getDashboardData(filters)\nCtrl -&gt; DB: SELECT aggregated_data, heatmap_points\nDB --&gt; Ctrl: Trả về dữ liệu đã tổng hợp\nCtrl --&gt; UI: Trực quan hóa đồ thị &amp; heatmap\nManager -&gt; UI: Chọn \&quot;Xuất báo cáo Excel\&quot;\nUI -&gt; Ctrl: exportReport(filters, format=\&quot;EXCEL\&quot;)\nCtrl -&gt; DB: FETCH full_report_dataset\nDB --&gt; Ctrl: Dữ liệu chi tiết\nCtrl -&gt; Ctrl: Generate Excel File Document\nCtrl --&gt; UI: Trả về Download URL / File Blob\nUI --&gt; Manager: Tự động tải tệp báo cáo về máy\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="cLNoQt3D1yF4KnxpFChZ-847">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
