        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle CỔNG THEO DÕI TIÊU THỤ NĂNG LƯỢNG TÒA NHÀ — ERD\n\n&#39; Dinh dang giao dien khung bang giong Hinh 2\nskinparam linetype ortho\nskinparam shadowing false\nskinparam titleFontSize 16\nskinparam titleFontAttribute bold\n\nskinparam class {\n    BackgroundColor #FFFFFF\n    HeaderBackgroundColor #FFF2CC\n    BorderColor #D6B656\n    FontName Arial\n    FontSize 11\n}\n\nentity \&quot;NguoiDung\&quot; as NguoiDung {\n  * &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; MaNguoiDung : INT\n  --\n  * &lt;color:red&gt;&lt;b&gt;UQ, NN&lt;/b&gt;&lt;/color&gt; TenDangNhap : VARCHAR(50)\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; MatKhauHash : VARCHAR(255)\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; HoTen : VARCHAR(100)\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; Email : VARCHAR(100)\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; VaiTro : VARCHAR(30)\n}\n\nentity \&quot;ToaNha\&quot; as ToaNha {\n  * &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; MaToaNha : INT\n  --\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; TenToaNha : VARCHAR(100)\n  DiaChi : TEXT\n  ToaDoGIS : GEOMETRY\n}\n\nentity \&quot;CongTo\&quot; as CongTo {\n  * &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; MaCongTo : INT\n  --\n  * &lt;color:red&gt;&lt;b&gt;UQ, NN&lt;/b&gt;&lt;/color&gt; MaCodeCongTo : VARCHAR(50)\n  * &lt;color:red&gt;&lt;b&gt;FK, NN&lt;/b&gt;&lt;/color&gt; MaToaNha : INT\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; LoaiNangLuong : VARCHAR(50)\n  ViTriLapDat : VARCHAR(150)\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; TrangThai : BOOLEAN\n}\n\nentity \&quot;DinhMucTieuThu\&quot; as DinhMucTieuThu {\n  * &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; MaDinhMuc : INT\n  --\n  * &lt;color:red&gt;&lt;b&gt;FK, NN&lt;/b&gt;&lt;/color&gt; MaToaNha : INT\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; ThangNam : DATE\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; NguongTieuThuChoPhep : DECIMAL(10,2)\n}\n\nentity \&quot;ChiSoGhiNhan\&quot; as ChiSoGhiNhan {\n  * &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; MaChiSo : BIGINT\n  --\n  * &lt;color:red&gt;&lt;b&gt;FK, NN&lt;/b&gt;&lt;/color&gt; MaCongTo : INT\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; ThoiGianGhi : TIMESTAMP\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; GiaTriTho : DECIMAL(10,2)\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; GiaTriXuLy : DECIMAL(10,2)\n}\n\nentity \&quot;BatThuongDuLieu\&quot; as BatThuongDuLieu {\n  * &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; MaLoiDuLieu : INT\n  --\n  * &lt;color:red&gt;&lt;b&gt;FK, NN&lt;/b&gt;&lt;/color&gt; MaChiSo : BIGINT\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; LoaiLoiKyThuat : VARCHAR(100)\n  MoTaLoi : TEXT\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; ThoiGianPhatHien : TIMESTAMP\n}\n\nentity \&quot;NhatKyBienDoiDuLieu\&quot; as NhatKyBienDoiDuLieu {\n  * &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; MaBienDoi : INT\n  --\n  * &lt;color:red&gt;&lt;b&gt;FK, NN&lt;/b&gt;&lt;/color&gt; MaChiSo : BIGINT\n  * &lt;color:red&gt;&lt;b&gt;FK, NN&lt;/b&gt;&lt;/color&gt; MaNguoiThucHien : INT\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; LoaiPhepBienDoi : VARCHAR(100)\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; GiaTriCu : DECIMAL(10,2)\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; GiaTriMoi : DECIMAL(10,2)\n  LyDoDieuChinh : TEXT\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; ThoiGianBienDoi : TIMESTAMP\n}\n\nentity \&quot;BatThuongTieuThu\&quot; as BatThuongTieuThu {\n  * &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; MaBatThuongTieuThu : INT\n  --\n  * &lt;color:red&gt;&lt;b&gt;FK, NN&lt;/b&gt;&lt;/color&gt; MaCongTo : INT\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; NgayGhiNhan : DATE\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; SoKWhTieuThu : DECIMAL(10,2)\n  MucVuotNguong : DECIMAL(10,2)\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; ThoiGianPhatHien : TIMESTAMP\n}\n\nentity \&quot;KeHoachTietKiem\&quot; as KeHoachTietKiem {\n  * &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; MaKeHoach : INT\n  --\n  * &lt;color:red&gt;&lt;b&gt;FK, NN&lt;/b&gt;&lt;/color&gt; MaToaNha : INT\n  * &lt;color:red&gt;&lt;b&gt;FK, NN&lt;/b&gt;&lt;/color&gt; MaNguoiTao : INT\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; TenKeHoach : VARCHAR(150)\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; MucTieuGiamPhanTram : DECIMAL(5,2)\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; NgayBatDau : DATE\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; NgayKetThuc : DATE\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; TrangThai : VARCHAR(30)\n}\n\nentity \&quot;GiaiPhapTietKiem\&quot; as GiaiPhapTietKiem {\n  * &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; MaGiaiPhap : INT\n  --\n  * &lt;color:red&gt;&lt;b&gt;FK, NN&lt;/b&gt;&lt;/color&gt; MaKeHoach : INT\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; TenGiaiPhap : VARCHAR(150)\n  MoTaChiTiet : TEXT\n  ChiPhiDuKien : DECIMAL(12,2)\n}\n\n&#39; Quan he giua cac bang\nToaNha \&quot;1\&quot; -- \&quot;N\&quot; CongTo : Thuộc\nToaNha \&quot;1\&quot; -- \&quot;N\&quot; DinhMucTieuThu : Thiết lập\nCongTo \&quot;1\&quot; -- \&quot;N\&quot; ChiSoGhiNhan : Ghi nhận\n\nChiSoGhiNhan \&quot;1\&quot; -- \&quot;N\&quot; BatThuongDuLieu : Phát hiện lỗi\nChiSoGhiNhan \&quot;1\&quot; -- \&quot;N\&quot; NhatKyBienDoiDuLieu : Lưu vết\nNguoiDung \&quot;1\&quot; -- \&quot;N\&quot; NhatKyBienDoiDuLieu : Thực hiện\n\nCongTo \&quot;1\&quot; -- \&quot;N\&quot; BatThuongTieuThu : Cảnh báo\n\nToaNha \&quot;1\&quot; -- \&quot;N\&quot; KeHoachTietKiem : Áp dụng\nNguoiDung \&quot;1\&quot; -- \&quot;N\&quot; KeHoachTietKiem : Khởi tạo\nKeHoachTietKiem \&quot;1\&quot; -- \&quot;N\&quot; GiaiPhapTietKiem : Bao gồm\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="T97jesPk8FcxKtwO9YVZ-185">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
