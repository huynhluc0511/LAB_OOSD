        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle CỔNG THEO DÕI TIÊU THỤ NĂNG LƯỢNG TÒA NHÀ — ERD\n\n&#39; Dinh dang giao dien khung bang\nskinparam linetype ortho\nskinparam shadowing false\nskinparam titleFontSize 16\nskinparam titleFontAttribute bold\n\nskinparam class {\n    BackgroundColor #FFFFFF\n    HeaderBackgroundColor #FFF2CC\n    BorderColor #D6B656\n    FontName Arial\n    FontSize 11\n}\n\nentity \&quot;NguoiDung (users)\&quot; as NguoiDung {\n  * &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; MaNguoiDung : INT\n  --\n  * &lt;color:red&gt;&lt;b&gt;UQ, NN&lt;/b&gt;&lt;/color&gt; TenDangNhap : VARCHAR(50)\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; MatKhauHash : VARCHAR(255)\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; HoTen : VARCHAR(100)\n  &lt;color:red&gt;&lt;b&gt;UQ&lt;/b&gt;&lt;/color&gt; Email : VARCHAR(100)\n  VaiTro : VARCHAR(50)\n  TrangThai : BOOLEAN\n  ThoiGianTao : TIMESTAMP\n}\n\nentity \&quot;ToaNha (buildings)\&quot; as ToaNha {\n  * &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; MaToaNha : INT\n  --\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; TenToaNha : VARCHAR(100)\n  DiaChi : TEXT\n  ViDo : DOUBLE PRECISION\n  KinhDo : DOUBLE PRECISION\n}\n\nentity \&quot;CongTo (meters)\&quot; as CongTo {\n  * &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; MaCongTo : INT\n  --\n  * &lt;color:red&gt;&lt;b&gt;UQ, NN&lt;/b&gt;&lt;/color&gt; MaCodeCongTo : VARCHAR(50)\n  * &lt;color:red&gt;&lt;b&gt;FK, NN&lt;/b&gt;&lt;/color&gt; MaToaNha : INT\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; LoaiCongTo : VARCHAR(50)\n  ViTriLapDat : VARCHAR(150)\n  ViDo : DOUBLE PRECISION\n  KinhDo : DOUBLE PRECISION\n  TrangThai : BOOLEAN\n}\n\nentity \&quot;DinhMucTieuThu (energy_quotas)\&quot; as DinhMucTieuThu {\n  * &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; MaDinhMuc : INT\n  --\n  * &lt;color:red&gt;&lt;b&gt;FK, NN&lt;/b&gt;&lt;/color&gt; MaToaNha : INT\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; ThangNam : DATE\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; NguongKWhToiDa : NUMERIC(10,2)\n}\n\nentity \&quot;ChiSoGhiNhan (energy_readings)\&quot; as ChiSoGhiNhan {\n  * &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; MaChiSo : INT\n  --\n  * &lt;color:red&gt;&lt;b&gt;FK, NN&lt;/b&gt;&lt;/color&gt; MaCongTo : INT\n  ThoiGianGhi : TIMESTAMP\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; GiaTriTho : NUMERIC(10,2)\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; GiaTriXuLy : NUMERIC(10,2)\n}\n\nentity \&quot;BatThuongDuLieu (data_anomalies)\&quot; as BatThuongDuLieu {\n  * &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; MaLoiDuLieu : INT\n  --\n  * &lt;color:red&gt;&lt;b&gt;FK, NN&lt;/b&gt;&lt;/color&gt; MaChiSo : INT\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; LoaiBatThuong : VARCHAR(100)\n  MoTa : TEXT\n  TrangThai : VARCHAR(50)\n  ThoiGianPhatHien : TIMESTAMP\n}\n\nentity \&quot;BatThuongTieuThu (consumption_anomalies)\&quot; as BatThuongTieuThu {\n  * &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; MaCanhBaoTieuThu : INT\n  --\n  * &lt;color:red&gt;&lt;b&gt;FK, NN&lt;/b&gt;&lt;/color&gt; MaCongTo : INT\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; NgayGhiNhan : DATE\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; MuaTieuThuKWh : NUMERIC(10,2)\n  MucVuotNguong : NUMERIC(10,2)\n  MucDoCanhBao : VARCHAR(50)\n  ThoiGianPhatHien : TIMESTAMP\n}\n\nentity \&quot;NhatKyBienDoiDuLieu (data_transformations)\&quot; as NhatKyBienDoiDuLieu {\n  * &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; MaBienDoi : INT\n  --\n  * &lt;color:red&gt;&lt;b&gt;FK, NN&lt;/b&gt;&lt;/color&gt; MaChiSo : INT\n  &lt;color:red&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/color&gt; MaNguoiThucHien : INT\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; LoaiPhepBienDoi : VARCHAR(100)\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; GiaTriGoc : NUMERIC(10,2)\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; GiaTriMoi : NUMERIC(10,2)\n  LyDo : TEXT\n  ThoiGianBienDoi : TIMESTAMP\n}\n\nentity \&quot;KeHoachTietKiem (saving_plans)\&quot; as KeHoachTietKiem {\n  * &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; MaKeHoach : INT\n  --\n  * &lt;color:red&gt;&lt;b&gt;FK, NN&lt;/b&gt;&lt;/color&gt; MaToaNha : INT\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; TenKeHoach : VARCHAR(150)\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; NgayBatDau : DATE\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; NgayKetThuc : DATE\n  PhanTramMucTieu : NUMERIC(5,2)\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; KWhGiamMucTieu : NUMERIC(10,2)\n  KWhDaTietKiem : NUMERIC(10,2)\n  TrangThai : VARCHAR(50)\n  &lt;color:red&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/color&gt; MaNguoiTao : INT\n  ThoiGianTao : TIMESTAMP\n}\n\nentity \&quot;GiaiPhapTietKiem (saving_solutions)\&quot; as GiaiPhapTietKiem {\n  * &lt;color:red&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/color&gt; MaGiaiPhap : INT\n  --\n  * &lt;color:red&gt;&lt;b&gt;FK, NN&lt;/b&gt;&lt;/color&gt; MaKeHoach : INT\n  * &lt;color:red&gt;&lt;b&gt;NN&lt;/b&gt;&lt;/color&gt; TenGiaiPhap : VARCHAR(200)\n  MoTa : TEXT\n  ChiPhiDuKien : NUMERIC(15,2)\n  KWhTietKiemDuKien : NUMERIC(10,2)\n  DaThucHien : BOOLEAN\n  ThoiGianThucHien : TIMESTAMP\n}\n\n&#39; Quan he giua cac bang\nToaNha \&quot;1\&quot; -- \&quot;N\&quot; CongTo : Thuộc\nToaNha \&quot;1\&quot; -- \&quot;N\&quot; DinhMucTieuThu : Áp dụng\nToaNha \&quot;1\&quot; -- \&quot;N\&quot; KeHoachTietKiem : Triển khai\n\nCongTo \&quot;1\&quot; -- \&quot;N\&quot; ChiSoGhiNhan : Ghi nhận\nCongTo \&quot;1\&quot; -- \&quot;N\&quot; BatThuongTieuThu : Phát hiện\n\nChiSoGhiNhan \&quot;1\&quot; -- \&quot;N\&quot; BatThuongDuLieu : Cảnh báo\nChiSoGhiNhan \&quot;1\&quot; -- \&quot;N\&quot; NhatKyBienDoiDuLieu : Lưu vết\n\nNguoiDung \&quot;1\&quot; -- \&quot;N\&quot; NhatKyBienDoiDuLieu : Thực hiện\nNguoiDung \&quot;1\&quot; -- \&quot;N\&quot; KeHoachTietKiem : Lập\n\nKeHoachTietKiem \&quot;1\&quot; -- \&quot;N\&quot; GiaiPhapTietKiem : Bao gồm\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="T97jesPk8FcxKtwO9YVZ-354">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
