        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\nactor \&quot;Bác sĩ\&quot; as BS\nboundary \&quot;FormKeToa\&quot; as GUI\ncontrol \&quot;ToaThuocControl\&quot; as CTL\nentity \&quot;Thuoc\&quot; as TH_E\nentity \&quot;ToaThuoc\&quot; as TT_E\nentity \&quot;ChiTietToaThuoc\&quot; as CTTT_E\n\nBS -&gt; GUI: 1. Chọn \&quot;Lập toa thuốc\&quot; (maPhieuKham)\nGUI -&gt; CTL: 2. khoiTaoToaThuoc(maPhieuKham)\nCTL --&gt; GUI: 3. Hiển thị form kê toa\n\nloop Kê từng loại thuốc\n  BS -&gt; GUI: 4. Tìm thuốc &amp; Chọn\n  GUI -&gt; CTL: 5. timThuoc(tenThuoc)\n  CTL -&gt; TH_E: 6. getInfo(tenThuoc)\n  TH_E --&gt; CTL: 7. Thông tin &amp; tác dụng phụ\n  CTL --&gt; GUI: 8. Hiển thị thông tin thuốc\n  BS -&gt; GUI: 9. Nhập số lượng, liều dùng, cách dùng\n  GUI -&gt; CTL: 10. themVaoToaTam(maThuoc, soLuong, lieuDung)\n  CTL --&gt; GUI: 11. Cập nhật danh sách tạm\nend\n\nBS -&gt; GUI: 12. Nhập lời dặn &amp; Bấm \&quot;Lưu toa thuốc\&quot;\nGUI -&gt; CTL: 13. luuToaThuoc(maPhieuKham, loiDangDung)\nCTL -&gt; TT_E: 14. createToaThuoc(maPhieuKham, ngayKe, loiDangDung)\nTT_E --&gt; CTL: 15. maToaThuoc\n\nloop Lưu các chi tiết toa thuốc\n  CTL -&gt; CTTT_E: 16. createChiTiet(maToaThuoc, maThuoc, soLuong, lieuDung)\n  CTTT_E --&gt; CTL: 17. Ok\nend\n\nCTL --&gt; GUI: 18. Báo lưu thành công\nGUI --&gt; BS: 19. In toa thuốc ra giấy\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="T97jesPk8FcxKtwO9YVZ-859">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
