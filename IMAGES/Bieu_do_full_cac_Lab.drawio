        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\n\nactor \&quot;Nhân viên HR\&quot; as HR\nactor \&quot;Giám đốc\&quot; as GD\n\nrectangle \&quot;Phân hệ Tiếp nhận Thử việc đến Ký Hợp đồng\&quot; {\n    usecase \&quot;UC01: Tuyển dụng &amp; Thử việc nhân viên\&quot; as UC1\n    usecase \&quot;UC1.1: Lập Quyết định thử việc\&quot; as UC1_1\n    usecase \&quot;UC1.2: Đánh giá kết quả thử việc\&quot; as UC1_2\n    usecase \&quot;UC2.1: Lập Hợp đồng lao động chính thức\&quot; as UC2_1\n    usecase \&quot;UC2.2: Lập Hồ sơ BHYT &amp; BHXH\&quot; as UC2_2\n    usecase \&quot;UC3.1: Ban hành Quyết định Chức vụ &amp; Phụ cấp\&quot; as UC3_1\n    usecase \&quot;UC3.2: Ban hành Quyết định Lương\&quot; as UC3_2\n}\n\nHR --&gt; UC1\nUC1 .&gt; UC1_1 : &lt;&lt;include&gt;&gt;\nUC1 .&gt; UC1_2 : &lt;&lt;include&gt;&gt;\n\nUC2_1 .&gt; UC1_2 : &lt;&lt;extend&gt;&gt;\nGD --&gt; UC2_1\n\nUC2_1 .&gt; UC2_2 : &lt;&lt;include&gt;&gt;\nUC2_1 .&gt; UC3_1 : &lt;&lt;include&gt;&gt;\nUC2_1 .&gt; UC3_2 : &lt;&lt;include&gt;&gt;\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wRxdrMt9qlu0CGxgFSHD-411">
