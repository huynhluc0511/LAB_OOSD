        <UserObject label="Sơ đồ Tuần tự - UC03: Quản lý Giỏ hàng" plantUmlId="title_40" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" plantUmlBaseValue="Sơ đồ Tuần tự - UC03: Quản lý Giỏ hàng" id="hNK0E6d8hQs80olfApI3-413">
          <mxCell parent="hNK0E6d8hQs80olfApI3-372" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1">
            <mxGeometry height="24" width="297.09049999999996" x="1801.5974" y="14640" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Sơ đồ Hoạt động - UC03: Quản lý Giỏ hàng\n\nstart\n:Khách hàng mở màn hình Giỏ hàng;\n:Hệ thống lấy thông tin giỏ hàng từ Session/CSDL;\n:Hiển thị danh sách sản phẩm, số lượng và tổng tiền;\n\nrepeat\n  if (Thao tác của Khách hàng?) then (Cập nhật số lượng)\n    :Nhập số lượng mới;\n    :Hệ thống kiểm tra số lượng tồn kho;\n    if (Đủ tồn kho?) then (Có)\n      :Cập nhật số lượng &amp; tính lại thành tiền;\n    else (Không đủ)\n      :Hiển thị thông báo vượt quá số lượng tồn;\n    endif\n  else if (Xóa sản phẩm) then (Xóa)\n    :Xác nhận xóa sản phẩm khỏi giỏ hàng;\n    :Hệ thống loại bỏ sản phẩm &amp; cập nhật tổng tiền;\n  else if (Nhập mã giảm giá) then (Áp dụng Voucher)\n    :Nhập mã Voucher;\n    :Hệ thống kiểm tra tính hợp lệ của Voucher;\n    if (Voucher hợp lệ?) then (Hợp lệ)\n      :Tính lại tổng tiền sau khi giảm giá;\n    else (Không hợp lệ)\n      :Báo lỗi mã giảm giá không hợp lệ/hết hạn;\n    endif\n  else (Nhấn \&quot;Tính tiền\&quot;)\n    break\n  endif\nrepeat while (Tiếp tục chỉnh sửa giỏ hàng?)\n\n:Chuyển hướng sang màn hình Đặt hàng &amp; Thanh toán (UC06);\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="hNK0E6d8hQs80olfApI3-308">
          <mxCell connectable="0" parent="hNK0E6d8hQs80olfApI3-372" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
