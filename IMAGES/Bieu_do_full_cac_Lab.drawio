        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\nclass NhanHieu {\n    - maLoai: String [PK]\n    - tenLoai: String\n    - moTa: String\n    + themNhanHieu(): void\n    + capNhatNhanHieu(): void\n}\n\nclass NhaCungUng {\n    - maNCU: String [PK]\n    - tenNCU: String\n    - diaChi: String\n    - soDienThoai: String\n    + themNhaCungUng(): void\n    + capNhatThongTin(): void\n}\n\nclass NuocGiaiKhat {\n    - maNGK: String [PK]\n    - tenNGK: String\n    - donViTinh: String\n    - soLuongTon: int\n    - donGiaBan: double\n    - maLoai: String [FK]\n    - maNCU: String [FK]\n    + capNhatTonKho(soLuong: int): void\n    + kiemTraTonKho(soLuongYeuCau: int): boolean\n}\n\nclass NhanVien {\n    - maNV: String [PK]\n    - hoTen: String\n    - chucVu: String\n    - soDienThoai: String\n    + lapHoaDon(): HoaDon\n    + lapPhieuGhiNo(): PhieuGhiNo\n}\n\nclass KhachHang {\n    - maKH: String [PK]\n    - tenKH: String\n    - diaChi: String\n    - soDienThoai: String\n    - loaiKhachHang: String\n    + capNhatLoaiKhach(): void\n}\n\nclass DonDatHang {\n    - maDDH: String [PK]\n    - soDDH: String\n    - ngayDat: Date\n    - ngayNhanDuKien: Date\n    - maNCU: String [FK]\n    - maNV: String [FK]\n    - trangThai: String\n    + taoDonDatHang(): void\n    + kiemTraSoDotGiao(): int\n}\n\nclass ChiTietDDH {\n    - maCTDDH: String [PK]\n    - maDDH: String [FK]\n    - maNGK: String [FK]\n    - soLuongDat: int\n    + capNhatSoLuongDat(): void\n}\n\nclass PhieuGiaoHang {\n    - maPGH: String [PK]\n    - soPhieuGiao: String\n    - maDDH: String [FK]\n    - ngayGiao: Date\n    - dotGiao: int\n    - soTienPhaiTra: double\n    - maNV: String [FK]\n    + taoPhieuGiao(): void\n    + xacNhanNhapKho(): void\n}\n\nclass ChiTietPhieuGiao {\n    - maCTPG: String [PK]\n    - maPGH: String [FK]\n    - maNGK: String [FK]\n    - soLuongGiao: int\n    - donGiaNhap: double\n    + tinhThanhTien(): double\n}\n\nclass HoaDon {\n    - maHD: String [PK]\n    - soHoaDon: String\n    - ngayLap: Date\n    - maKH: String [FK]\n    - maNV: String [FK]\n    - tongTien: double\n    - trangThaiThanhToan: String\n    + taoHoaDon(): void\n    + tinhTongTien(): double\n}\n\nclass ChiTietHoaDon {\n    - maCTHD: String [PK]\n    - maHD: String [FK]\n    - maNGK: String [FK]\n    - soLuong: int\n    - donGia: double\n    + tinhThanhTien(): double\n}\n\nclass PhieuHenGiao {\n    - maPhieuHen: String [PK]\n    - soPhieuHen: String\n    - maHD: String [FK]\n    - ngayHenGiao: Date\n    - dotGiao: int\n    - trangThai: String\n    - maNV: String [FK]\n    + taoPhieuHen(): void\n    + xacNhanGiaoThanhCong(): void\n}\n\nclass ChiTietPhieuHen {\n    - maCTPH: String [PK]\n    - maPhieuHen: String [FK]\n    - maNGK: String [FK]\n    - soLuongHen: int\n    + capNhatSoLuongHen(): void\n}\n\nclass PhieuGhiNo {\n    - maPhieuNo: String [PK]\n    - soPhieuNo: String\n    - ngayLap: Date\n    - maKH: String [FK]\n    - maHD: String [FK]\n    - soTienNo: double\n    - ngayDuKienTra: Date\n    - lyDoNo: String\n    - trangThai: String\n    - maNV: String [FK]\n    + taoPhieuGhiNo(): void\n    + thanhToanNo(soTien: double): void\n}\n\nNhanHieu \&quot;1\&quot; -- \&quot;0..*\&quot; NuocGiaiKhat\nNhaCungUng \&quot;1\&quot; -- \&quot;1..*\&quot; NuocGiaiKhat\nNhaCungUng \&quot;1\&quot; -- \&quot;0..*\&quot; DonDatHang\nDonDatHang \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietDDH\nNuocGiaiKhat \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietDDH\n\nDonDatHang \&quot;1\&quot; o-- \&quot;1..3\&quot; PhieuGiaoHang\nPhieuGiaoHang \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhieuGiao\nNuocGiaiKhat \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhieuGiao\n\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; HoaDon\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; HoaDon\nHoaDon \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietHoaDon\nNuocGiaiKhat \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietHoaDon\n\nHoaDon \&quot;1\&quot; o-- \&quot;0..*\&quot; PhieuHenGiao\nPhieuHenGiao \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhieuHen\nNuocGiaiKhat \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhieuHen\n\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuGhiNo\nHoaDon \&quot;1\&quot; -- \&quot;0..1\&quot; PhieuGhiNo\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuGhiNo\n@endl&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="XBLFZ7L_sZrkkt03i62t-32">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
