        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\nskinparam actorStyle solid\n\nactor \&quot;Bệnh nhân\&quot; as BN\nactor \&quot;Nhân viên CSKH\&quot; as CSKH\nactor \&quot;Bác sĩ\&quot; as BS\n\nrectangle \&quot;Hệ thống Quản lý Hồ sơ Bệnh án Bệnh viện\&quot; {\n  usecase \&quot;UC01: Đăng ký khám ban đầu &amp; Cấp hồ sơ\&quot; as UC01\n  usecase \&quot;UC02: Thu / Gia hạn lệ phí hằng năm\&quot; as UC02\n  usecase \&quot;UC03: Đặt hẹn khám định kỳ theo quý\&quot; as UC03\n  usecase \&quot;UC04: Tra cứu &amp; Xem lý lịch bệnh án\&quot; as UC04\n  usecase \&quot;UC05: Khám bệnh &amp; Ghi nhận triệu chứng\&quot; as UC05\n  usecase \&quot;UC06: Chỉ định &amp; Trả KQ xét nghiệm\&quot; as UC06\n  usecase \&quot;UC07: Lập toa thuốc (Kê đơn thuốc)\&quot; as UC07\n  usecase \&quot;UC08: Thanh toán viện phí &amp; Xuất viện\&quot; as UC08\n  usecase \&quot;UC09: Ghi nhận diễn biến &amp; Phản ứng phụ\&quot; as UC09\n}\n\nBN -- UC01\nBN -- UC02\nBN -- UC03\nBN -- UC05\nBN -- UC08\n\nCSKH -- UC01\nCSKH -- UC02\nCSKH -- UC03\nCSKH -- UC04\nCSKH -- UC08\nCSKH -- UC09\n\nBS -- UC04\nBS -- UC05\nBS -- UC06\nBS -- UC07\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="T97jesPk8FcxKtwO9YVZ-1209">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
