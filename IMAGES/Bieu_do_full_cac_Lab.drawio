        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Sequence Diagram - UC05: Phát hiện bất thường dữ liệu (Data Anomaly)\nautonumber\nactor \&quot;Data Quality Job\&quot; as Job\ncontrol \&quot;Data Anomaly Engine\&quot; as Engine\nentity \&quot;PostgreSQL\&quot; as DB\nactor \&quot;Kỹ thuật viên\&quot; as Tech\n\nJob -&gt; Engine: runDataQualityCheck()\nEngine -&gt; DB: FETCH raw_telemetry_unprocessed\nDB --&gt; Engine: Danh sách dữ liệu thô\nEngine -&gt; Engine: Apply Validation Rules (Check Null, Negative, Spike)\nalt Phát hiện bất thường dữ liệu\n    Engine -&gt; DB: UPDATE raw_telemetry SET flag=\&quot;DATA_ANOMALY\&quot;, error_code\n    Engine -&gt; DB: INSERT INTO anomaly_logs\n    Engine -&gt; Tech: sendTechnicalAlert(meter_id, error_details)\nelse Dữ liệu đạt chuẩn\n    Engine -&gt; DB: UPDATE raw_telemetry SET flag=\&quot;VALID\&quot;\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="cLNoQt3D1yF4KnxpFChZ-573">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
