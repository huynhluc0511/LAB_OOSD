        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\n\n&#39; Định nghĩa các Actor\nactor \&quot;Khách Đoàn\\n(&gt; 12 người)\&quot; as KD\nactor \&quot;Khách Lẻ\\n(&lt; 12 người)\&quot; as KL\nactor \&quot;NV Bán Vé / Lễ Tân\&quot; as NVBV\nactor \&quot;NV Kinh Doanh / CSKH\&quot; as NVKD\nactor \&quot;NV Điều Hành\&quot; as NVDH\nactor \&quot;Hướng Dẫn Viên\&quot; as HDV\nactor \&quot;Kế Toán\&quot; as KT\nactor \&quot;Quản Lý / Admin\&quot; as QL\n\nrectangle \&quot;Hệ Thống Quản Lý Công Ty Du Lịch Văn Hóa Việt\&quot; {\n    usecase \&quot;Tra cứu thông tin Tour / Chuyến\&quot; as UC_TraCuu\n    usecase \&quot;Đăng ký Tour theo đoàn\&quot; as UC_DangKyDoan\n    usecase \&quot;Đăng ký Tour theo chuyến (Vé lẻ)\&quot; as UC_DangKyChuyen\n    usecase \&quot;Phân công Hướng dẫn viên\&quot; as UC_PhanCong\n    usecase \&quot;Thanh toán &amp; Quyết toán Tour\&quot; as UC_ThanhToan\n    usecase \&quot;Tính lương Hướng dẫn viên\&quot; as UC_TinhLuong\n    usecase \&quot;Gửi &amp; Tiếp nhận phiếu khảo sát\&quot; as UC_KhaoSat\n    usecase \&quot;Quản lý Danh mục Tour &amp; Lộ trình\&quot; as UC_QLTour\n}\n\n&#39; Mối liên kết giữa Actor và Use Case (Nét liền KHÔNG mũi tên)\nKD -- UC_TraCuu\nKD -- UC_DangKyDoan\nKD -- UC_KhaoSat\n\nKL -- UC_TraCuu\nKL -- UC_DangKyChuyen\nKL -- UC_KhaoSat\n\nNVBV -- UC_DangKyChuyen\n\nNVKD -- UC_DangKyDoan\nNVKD -- UC_KhaoSat\n\nNVDH -- UC_PhanCong\nHDV -- UC_PhanCong\n\nKT -- UC_ThanhToan\nKT -- UC_TinhLuong\n\nQL -- UC_QLTour\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="PDo0V7vI7fF-Ga1DuarB-353">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
