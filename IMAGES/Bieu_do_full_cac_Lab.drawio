        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\nactor \&quot;NV Bán hàng\&quot; as NVBH\nboundary \&quot;FormPhieuGhiNo\&quot; as Form\ncontrol \&quot;PhieuGhiNoService\&quot; as Service\nentity \&quot;KhachHang\&quot; as KH\nentity \&quot;HoaDon\&quot; as HD\nentity \&quot;PhieuGhiNo\&quot; as PGN\ndatabase \&quot;SQL Server DB\&quot; as DB\n\nNVBH -&gt; Form : 1. MoFormLapPhieuNo(maHD)\nactivate Form\n\nForm -&gt; Service : 2. layThongTinHoaDon(maHD)\nactivate Service\nService -&gt; HD : 3. getHoaDon(maHD)\nactivate HD\nHD --&gt; Service : 4. thongTinHoaDon\ndeactivate HD\nService --&gt; Form : 5. hienThiThongTin(HD)\ndeactivate Service\n\nNVBH -&gt; Form : 6. NhapNgayHenTra, SoTienNo, LyDoNo\nNVBH -&gt; Form : 7. Click \&quot;Lưu Phiếu Ghi Nợ\&quot;\n\nForm -&gt; Service : 8. taoPhieuGhiNo(maHD, maKH, soTienNo, ngayHenTra, lyDoNo)\nactivate Service\n\nService -&gt; KH : 9. kiemTraKhachQuen(maKH)\nactivate KH\nKH --&gt; Service : 10. isKhachQuen = true\ndeactivate KH\n\nalt Khách hàng là Khách quen\n    Service -&gt; PGN : 11. create(maPhieuNo, maHD, maKH, soTienNo, ngayHenTra, lyDoNo)\n    activate PGN\n    PGN --&gt; Service : 12. doiTuongPGN\n    deactivate PGN\n    \n    Service -&gt; HD : 13. capNhatTrangThai(\&quot;Ghi nợ\&quot;)\n    activate HD\n    HD --&gt; Service : 14. ok\n    deactivate HD\n\n    Service -&gt; DB : 15. INSERT INTO PhieuGhiNo &amp; UPDATE HoaDon (Transaction)\n    activate DB\n    DB --&gt; Service : 16. Transaction Committed Success\n    deactivate DB\n\n    Service --&gt; Form : 17. Thông báo \&quot;Lập phiếu ghi nợ thành công\&quot;\n    Form --&gt; NVBH : 18. Hiển thị thông báo &amp; In phiếu nợ\nelse Không phải Khách quen\n    Service --&gt; Form : 19. Báo lỗi \&quot;Khách vãng lai không được phép ghi nợ\&quot;\n    Form --&gt; NVBH : 20. Hiển thị thông báo lỗi\nend\n\ndeactivate Service\ndeactivate Form\n@endl&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="XBLFZ7L_sZrkkt03i62t-435">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
