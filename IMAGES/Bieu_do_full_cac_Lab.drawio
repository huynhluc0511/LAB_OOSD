        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\nclass KhachHang {\n    - maKhachHang: String {id}\n    - hoTenNguoiDaiDien: String\n    - soDienThoai: String\n    - diaChi: String\n    + dangKyTour()\n    + thanhToan()\n}\n\nclass KhachDoan {\n    - maKhachDoan: String {id}\n    - tenCoQuanGiaDinh: String\n    - diaChiCoQuan: String\n    - soDienThoaiCoQuan: String\n    - soNguoiDi: int\n    - diaDiemDonYeuCau: String\n    - ngayDiChon: Date\n    - coBaoHiem: boolean\n    + lapPhieuDangKyDoan()\n    + datCoc()\n    + nopDanhSachBaoHiem()\n    + thanhToanQuyetToan()\n}\n\nclass KhachLe {\n    - maKhachLe: String {id}\n    - soNguoi: int\n    - diemBanVe: String\n    + muaVeChuyen()\n    + thanhToanTienVe()\n}\n\nclass Tour {\n    - maTour: String {id}\n    - tenTour: String\n    - soNgay: int\n    - soDem: int\n    - donGia: double\n    + taoTour()\n    + capNhatTour()\n    + tinhChiPhi()\n    + layThongTinTour()\n}\n\nclass NoiDungChan {\n    - maDungChan: String {id}\n    - thuTuDung: int\n    - coDoiPhuongTien: boolean\n    - coNoiAn: boolean\n    - coKhachSan: boolean\n    - loaiKhachSan: int\n    + capNhatThongTin()\n    + layThongTinDungChan()\n}\n\nclass DiemThamQuan {\n    - maDiemThamQuan: String {id}\n    - tenDiemThamQuan: String\n    - diaDiem: String\n    - noiDung: String\n    - yNghia: String\n    + themDiemThamQuan()\n    + layThongTin()\n}\n\nclass PhuongTien {\n    - maPhuongTien: String {id}\n    - tenPhuongTien: String\n    + layThongTinPhuongTien()\n}\n\nclass ChuyenDi {\n    - maChuyenDi: String {id}\n    - ngayDi: Date\n    - ngayVe: Date\n    - soChoToiDa: int\n    - soChoConLai: int\n    + kiemTraChoTrong()\n    + capNhatCho()\n}\n\nclass PhieuDangKyDoan {\n    - maPhieuDoan: String {id}\n    - ngayLap: Date\n    - tienCoc: double\n    - tongTien: double\n    - trangThaiThanhToan: String\n    + taoPhieu()\n    + xacNhanCoc()\n    + thanhToanKhauTru()\n}\n\nclass VeTour {\n    - maVe: String {id}\n    - ngayIn: Date\n    - giaVe: double\n    - diaDiemDonQuyDinh: String\n    + inVe()\n    + xacNhanThanhToan()\n}\n\nclass DanhSachBaoHiem {\n    - maDanhSach: String {id}\n    - soLuong: int\n    + themNguoiDiCung()\n    + xuatDanhSach()\n}\n\nclass NguoiDiCung {\n    - maNguoiDiCung: String {id}\n    - hoTen: String\n    - ngaySinh: Date\n    - cccd: String\n    + layThongTin()\n}\n\nclass NhanVienHDV {\n    - maHDV: String {id}\n    - hoTen: String\n    - soDienThoai: String\n    - luongCanBan: double\n    + kiemTraLichRanh()\n    + tinhLuongThang()\n}\n\nclass PhanCongHDV {\n    - maPhanCong: String {id}\n    - ngayBatDau: Date\n    - ngayKetThuc: Date\n    - thuLaoTour: double\n    + phanCong()\n    + kiemTraTrungLich()\n}\n\nclass PhieuKhaoSat {\n    - maPhieuKS: String {id}\n    - ngayGui: Date\n    - noiDungGopY: String\n    - mucDoHaiLong: int\n    + guiPhieu()\n    + ghiNhanGopY()\n}\n\n&#39; Mối quan hệ kế thừa (Generalization)\nKhachHang &lt;|-- KhachDoan\nKhachHang &lt;|-- KhachLe\n\n&#39; Mối quan hệ Composition &amp; Association\nTour \&quot;1\&quot; *-- \&quot;1..*\&quot; NoiDungChan\nNoiDungChan \&quot;*\&quot; -- \&quot;0..*\&quot; DiemThamQuan\nNoiDungChan \&quot;*\&quot; -- \&quot;1..*\&quot; PhuongTien\nTour \&quot;1\&quot; -- \&quot;0..*\&quot; ChuyenDi\n\nKhachDoan \&quot;1\&quot; -- \&quot;1..*\&quot; PhieuDangKyDoan\nPhieuDangKyDoan \&quot;*\&quot; -- \&quot;1\&quot; Tour\nKhachDoan \&quot;1\&quot; -- \&quot;0..1\&quot; DanhSachBaoHiem\nDanhSachBaoHiem \&quot;1\&quot; *-- \&quot;1..*\&quot; NguoiDiCung\n\nKhachLe \&quot;1\&quot; -- \&quot;1..*\&quot; VeTour\nVeTour \&quot;*\&quot; -- \&quot;1\&quot; ChuyenDi\n\nNhanVienHDV \&quot;1\&quot; -- \&quot;0..*\&quot; PhanCongHDV\nPhanCongHDV \&quot;*\&quot; -- \&quot;0..1\&quot; ChuyenDi\nPhanCongHDV \&quot;*\&quot; -- \&quot;0..1\&quot; PhieuDangKyDoan\n\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKhaoSat\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="PDo0V7vI7fF-Ga1DuarB-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
