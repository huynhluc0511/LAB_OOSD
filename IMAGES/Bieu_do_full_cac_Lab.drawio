            <mxGeometry height="24" width="465" x="753.5" y="29890" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Sequence Diagram - UC02: Thu thập và tổng hợp dữ liệu tiêu thụ\nautonumber\nactor \&quot;IoT Gateway\&quot; as IoT\nboundary \&quot;Ingestion API (FastAPI/Spring)\&quot; as API\ncontrol \&quot;Aggregation Engine\&quot; as Engine\nentity \&quot;PostgreSQL\&quot; as DB\nactor \&quot;OpenTelemetry\&quot; as OTel &lt;&lt; System &gt;&gt;\n\nIoT -&gt; API: POST /api/v1/telemetry (meter_id, payload, timestamp)\nalt Gói dữ liệu hợp lệ\n    API -&gt; DB: INSERT INTO raw_telemetry\n    DB --&gt; API: Xác nhận đã lưu\n    API -&gt; Engine: triggerAggregation(meter_id, timestamp)\n    Engine -&gt; DB: CALCULATE &amp; INSERT INTO aggregated_consumption\n    Engine -&gt; OTel: pushMetric(data_ingested_count, latency)\n    API --&gt; IoT: HTTP 200 OK\nelse Dữ liệu lỗi cấu trúc\n    API --&gt; IoT: HTTP 400 Bad Request\n    API -&gt; OTel: pushMetric(ingestion_error_count)\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="cLNoQt3D1yF4KnxpFChZ-410">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
