        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\nskinparam actorStyle stickman\n\n&#39;=================== DANH SÁCH ACTOR ===================\n&#39; Nhóm Kho &amp; NCC (Đưa lên đầu)\nactor \&quot;Nhân viên Kho\&quot; as NVKho\nactor \&quot;Nhà cung ứng\\n«External»\&quot; as NCC\n\n&#39; Nhóm Bán hàng &amp; Khách hàng (Đưa vào giữa)\nactor \&quot;Nhân viên Bán hàng\&quot; as NVBH\nactor \&quot;Khách hàng\\n«External»\&quot; as KH\n\n&#39; Nhóm Quản lý (Đưa xuống cuối)\nactor \&quot;Quản lý / Chủ cửa hàng\&quot; as QuanLy\n\n&#39;=================== SYSTEM BOUNDARY ===================\nrectangle \&quot;Hệ thống Quản lý Cửa hàng Nước Giải Khát\&quot; {\n    \n    &#39; Phân hệ 1: Quản lý Đặt &amp; Nhận hàng NCC\n    usecase \&quot;UC02: Quản lý Đặt hàng NCC\&quot; as UC02\n    usecase \&quot;UC03: Quản lý Nhận hàng\&quot; as UC03\n    \n    &#39; Phân hệ 2: Bán hàng, Phiếu hẹn &amp; Công nợ\n    usecase \&quot;UC04: Bán hàng &amp; Lập Hóa đơn\&quot; as UC04\n    usecase \&quot;UC05: Lập Phiếu hẹn giao hàng\&quot; as UC05\n    usecase \&quot;UC06: Lập &amp; Quản lý Phiếu ghi nợ\&quot; as UC06\n    \n    &#39; Phân hệ 3: Danh mục &amp; Báo cáo Quản lý\n    usecase \&quot;UC01: Quản lý Danh mục\&quot; as UC01\n    usecase \&quot;UC07: Báo cáo Thống kê\&quot; as UC07\n}\n\n&#39;=================== ASSOCIATIONS (NÉT LIỀN, KHÔNG MŨI TÊN) ===================\n&#39; Nối phân hệ Kho &amp; NCC\nNVKho -- UC02\nNVKho -- UC03\nNCC -- UC02\nNCC -- UC03\n\n&#39; Nối phân hệ Bán hàng &amp; Khách hàng\nNVBH -- UC04\nNVBH -- UC05\nNVBH -- UC06\nKH -- UC04\nKH -- UC05\nKH -- UC06\n\n&#39; Nối phân hệ Quản lý\nQuanLy -- UC01\nQuanLy -- UC07\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="XBLFZ7L_sZrkkt03i62t-490">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
