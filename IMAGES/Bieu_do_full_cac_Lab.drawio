        <UserObject label="Activity Diagram - UC02: Thu thập và tổng hợp dữ liệu tiêu thụ" plantUmlId="title_0" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" plantUmlBaseValue="Activity Diagram - UC02: Thu thập và tổng hợp dữ liệu tiêu thụ" id="cLNoQt3D1yF4KnxpFChZ-409">
