        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam linetype ortho\n\nentity \&quot;NguoiDung\&quot; as NguoiDung {\n  * PK : MaNguoiDung : INT\n  --\n  * UQ, NN : TenDangNhap : VARCHAR(50)\n  * NN : MatKhauHash : VARCHAR(255)\n  * NN : HoTen : VARCHAR(100)\n  * NN : Email : VARCHAR(100)\n  * NN : VaiTro : VARCHAR(30)\n}\n\nentity \&quot;KhongGianToaNha\&quot; as KhongGianToaNha {\n  * PK : MaKhongGian : INT\n  --\n  * NN : TenKhongGian : VARCHAR(100)\n  * NN : LoaiKhongGian : VARCHAR(50)\n  FK : MaKhongGianCha : INT\n  ToaDoGIS : GEOMETRY\n}\n\nentity \&quot;CongTo\&quot; as CongTo {\n  * PK : MaCongTo : INT\n  --\n  * FK, NN : MaKhongGian : INT\n  * UQ, NN : MaCodeCongTo : VARCHAR(50)\n  * NN : LoaiNangLuong : VARCHAR(30)\n  ThongSoKyThuat : TEXT\n  * NN : TrangThai : VARCHAR(20)\n}\n\nentity \&quot;ChiSoGhiNhan\&quot; as ChiSoGhiNhan {\n  * PK : MaChiSo : BIGINT\n  --\n  * FK, NN : MaCongTo : INT\n  * NN : GiaTriTho : DECIMAL(12,2)\n  GiaTriDaLamSach : DECIMAL(12,2)\n  * NN : ThoiGianGhi : TIMESTAMP\n  * NN : TrangThaiDuLieu : VARCHAR(20)\n}\n\nentity \&quot;BatThuongDuLieu\&quot; as BatThuongDuLieu {\n  * PK : MaSuKienData : INT\n  --\n  * FK, NN : MaChiSo : BIGINT\n  * NN : LoaiLoiKyThuat : VARCHAR(50)\n  * NN : ThoiGianPhatHien : TIMESTAMP\n  * NN : TrangThaiGiaiQuyet : VARCHAR(30)\n}\n\nentity \&quot;NhatKyBienDoiDuLieu\&quot; as NhatKyBienDoiDuLieu {\n  * PK : MaBienDoi : INT\n  --\n  * FK, NN : MaChiSo : BIGINT\n  * FK, NN : MaNguoiThucHien : INT\n  * NN : PhuongPhapBienDoi : VARCHAR(50)\n  GiaTriCu : DECIMAL(12,2)\n  GiaTriMoi : DECIMAL(12,2)\n  LyDoDieuChinh : TEXT\n  * NN : ThoiGianBienDoi : TIMESTAMP\n}\n\nentity \&quot;DinhMucTieuThu\&quot; as DinhMucTieuThu {\n  * PK : MaDinhMuc : INT\n  --\n  * FK, NN : MaKhongGian : INT\n  * NN : NguongKWh : DECIMAL(10,2)\n  * NN : KhungThoiGian : VARCHAR(30)\n  * NN : NgayBatDau : DATE\n  * NN : NgayKetThuc : DATE\n}\n\nentity \&quot;BatThuongTieuThu\&quot; as BatThuongTieuThu {\n  * PK : MaCanhBao : INT\n  --\n  * FK, NN : MaKhongGian : INT\n  FK : MaDinhMuc : INT\n  * NN : MucTieuThuThucTe : DECIMAL(10,2)\n  * NN : MucChenhLech : DECIMAL(10,2)\n  * NN : ThoiGianCanhBao : TIMESTAMP\n  * NN : MucDo : VARCHAR(20)\n  * NN : TrangThaiXacNhan : BOOLEAN\n}\n\nentity \&quot;KeHoachTietKiem\&quot; as KeHoachTietKiem {\n  * PK : MaKeHoach : INT\n  --\n  * FK, NN : MaKhongGian : INT\n  * FK, NN : MaNguoiTao : INT\n  * NN : TenKeHoach : VARCHAR(150)\n  * NN : MucTieuGiamPercent : DECIMAL(5,2)\n  * NN : NgayBatDau : DATE\n  * NN : NgayKetThuc : DATE\n  * NN : TrangThai : VARCHAR(30)\n}\n\nentity \&quot;GiaiPhapTietKiem\&quot; as GiaiPhapTietKiem {\n  * PK : MaGiaiPhap : INT\n  --\n  * FK, NN : MaKeHoach : INT\n  * NN : TenGiaiPhap : VARCHAR(150)\n  NoiDungChiTiet : TEXT\n  ChiPhiDuKien : DECIMAL(12,2)\n}\n\n&#39; Quan he (Relationships)\nKhongGianToaNha ||--o{ KhongGianToaNha\nKhongGianToaNha ||--|{ CongTo\nCongTo ||--|{ ChiSoGhiNhan\n\nChiSoGhiNhan ||--o{ BatThuongDuLieu\nChiSoGhiNhan ||--o{ NhatKyBienDoiDuLieu\nNguoiDung ||--o{ NhatKyBienDoiDuLieu\n\nKhongGianToaNha ||--|{ DinhMucTieuThu\nKhongGianToaNha ||--|{ BatThuongTieuThu\nDinhMucTieuThu ||--o{ BatThuongTieuThu\n\nKhongGianToaNha ||--|{ KeHoachTietKiem\nNguoiDung ||--|{ KeHoachTietKiem\nKeHoachTietKiem ||--|{ GiaiPhapTietKiem\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="G0Ln0jxJWr0k0JKpy_vq-2">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
