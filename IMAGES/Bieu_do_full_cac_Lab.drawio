        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide footbox\nskinparam classAttributeIconSize 0\ntitle Sơ đồ Lớp Thiết Kế (Design Class Diagram) - UC03 &amp; UC06\n\n&#39; --- ENUMS ---\nenum OrderStatus {\n  PENDING_PAYMENT\n  PAYMENT_FAILED\n  PAID\n  PROCESSING\n  SHIPPING\n  DELIVERED\n  CANCELLED\n}\n\nenum TicketType {\n  STANDARD\n  EXPRESS\n  SAME_DAY_EXPRESS\n}\n\n&#39; --- ENTITIES ---\nclass Customer {\n  - userId: String\n  - fullName: String\n  - email: String\n  - phone: String\n  - address: String\n  + getProfile(): Customer\n  + updateAddress(address: String): void\n}\n\nclass Product {\n  - productId: String\n  - name: String\n  - price: double\n  - stockQuantity: int\n  + checkStock(qty: int): boolean\n  + updateStock(qty: int): void\n}\n\nclass Cart {\n  - cartId: String\n  - userId: String\n  - totalAmount: double\n  + addItem(product: Product, qty: int): void\n  + updateQuantity(productId: String, qty: int): void\n  + removeItem(productId: String): void\n  + calculateTotal(): double\n  + clear(): void\n}\n\nclass CartItem {\n  - cartItemId: String\n  - quantity: int\n  - unitPrice: double\n  + getSubtotal(): double\n}\n\nclass Order {\n  - orderId: String\n  - orderDate: Date\n  - status: OrderStatus\n  - ticketType: TicketType\n  - shippingFee: double\n  - totalAmount: double\n  - shippingAddress: String\n  + calculateShippingFee(): double\n  + calculateTotal(): double\n  + updateStatus(status: OrderStatus): void\n}\n\nclass OrderItem {\n  - orderItemId: String\n  - quantity: int\n  - unitPrice: double\n  + getSubtotal(): double\n}\n\nclass Payment {\n  - paymentId: String\n  - cardType: String\n  - cardNumberMasked: String\n  - amount: double\n  - paymentStatus: String\n  - paymentDate: Date\n  + processPayment(): boolean\n}\n\nclass Voucher {\n  - code: String\n  - discountValue: double\n  - minOrderValue: double\n  - expiryDate: Date\n  + isValid(orderTotal: double): boolean\n}\n\nclass CardDTO {\n  + cardType: String\n  + cardNumber: String\n  + expiryDate: String\n  + cardHolderName: String\n  + csv: String\n}\n\n&#39; --- CONTROLLERS ---\nclass CartController {\n  + getCartInfo(userId: String): Cart\n  + updateQuantity(productId: String, qty: int): void\n  + removeItem(productId: String): void\n  + applyVoucher(code: String): double\n}\n\nclass OrderController {\n  + calculateShipping(orderTotal: double, address: String, ticketType: TicketType): double\n  + processCheckout(userId: String, cardInfo: CardDTO): Order\n}\n\n&#39; --- SERVICES ---\nclass CartService {\n  + getCartByUserId(userId: String): Cart\n  + updateItem(userId: String, productId: String, qty: int): boolean\n  + deleteItem(userId: String, productId: String): boolean\n}\n\nclass OrderService {\n  + createOrder(userId: String, cart: Cart, address: String, ticketType: TicketType): Order\n  + finalizeOrder(orderId: String): boolean\n}\n\nclass PaymentService {\n  + authorizeAndCharge(cardData: CardDTO, amount: double): boolean\n}\n\nclass EmailService {\n  + sendOrderConfirmation(email: String, order: Order): void\n}\n\n&#39; --- RELATIONSHIPS ---\nCustomer \&quot;1\&quot; -- \&quot;0..1\&quot; Cart : owns &gt;\nCustomer \&quot;1\&quot; -- \&quot;0..*\&quot; Order : places &gt;\n\nCart \&quot;1\&quot; *-- \&quot;0..*\&quot; CartItem : contains &gt;\nCartItem \&quot;1\&quot; --&gt; \&quot;1\&quot; Product : references &gt;\n\nOrder \&quot;1\&quot; *-- \&quot;1..*\&quot; OrderItem : contains &gt;\nOrderItem \&quot;1\&quot; --&gt; \&quot;1\&quot; Product : references &gt;\nOrder \&quot;1\&quot; -- \&quot;1\&quot; Payment : paid by &gt;\nOrder \&quot;0..*\&quot; -- \&quot;0..1\&quot; Voucher : applies &gt;\n\nCartController ..&gt; CartService : uses\nOrderController ..&gt; OrderService : uses\nOrderController ..&gt; PaymentService : uses\nOrderController ..&gt; CardDTO : receives\n\nOrderService ..&gt; EmailService : uses\nCartService ..&gt; Cart : manages\nOrderService ..&gt; Order : manages\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="hNK0E6d8hQs80olfApI3-545">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Sơ đồ Lớp Thiết Kế (Design Class Diagram) - UC03 &amp;amp; UC06" plantUmlId="cltitle_2" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" plantUmlBaseValue="Sơ đồ Lớp Thiết Kế (Design Class Diagram) - UC03 &amp;amp; UC06" id="hNK0E6d8hQs80olfApI3-546">
