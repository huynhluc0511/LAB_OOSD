        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Sequence Diagram - UC04: Giám sát và cảnh báo vượt định mức\nautonumber\nactor \&quot;Timer / Job Scheduler\&quot; as Job\ncontrol \&quot;Monitor Engine\&quot; as Engine\nentity \&quot;PostgreSQL\&quot; as DB\nboundary \&quot;UI Dashboard\&quot; as UI\nactor \&quot;Quản lý năng lượng\&quot; as Manager\n\nJob -&gt; Engine: executeMonitoringCheck()\nEngine -&gt; DB: SELECT actual_usage, quota_limit FROM consumption_v_quota\nDB --&gt; Engine: Trả về chỉ số tiêu thụ &amp; định mức\nalt Thực tế vượt định mức\n    Engine -&gt; DB: INSERT INTO alert_logs (type=\&quot;QUOTA_EXCEEDED\&quot;)\n    Engine -&gt; UI: pushAlertNotification(alertData)\n    UI --&gt; Manager: Hiển thị cảnh báo màu đỏ/vàng trên màn hình\nelse Tiêu thụ trong định mức\n    Engine -&gt; DB: UPDATE area_status SET status=\&quot;NORMAL\&quot;\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="cLNoQt3D1yF4KnxpFChZ-522">
